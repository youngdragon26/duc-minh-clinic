# Chuỗi kết nối PostgreSQL miễn phí, lấy từ Neon (neon.tech) hoặc Supabase.
# Dạng: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Lấy tại https://console.anthropic.com (mục API Keys). Không bắt buộc để chạy
# server — thiếu biến này thì chatbot AI và tóm tắt bệnh sử AI tự tắt, các
# chức năng khác vẫn hoạt động bình thường.
ANTHROPIC_API_KEY=
# Không bắt buộc — model dùng cho chatbot công khai (mặc định rẻ, nhanh) và
# tóm tắt bệnh sử cho bác sĩ (mặc định mạnh hơn, ít câu hỏi hơn).
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5
