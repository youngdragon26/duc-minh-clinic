PORT=4000
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-trien-khai-that
ADMIN_REGISTER_CODE=DUCMINH-ADMIN-2026

# Chuỗi kết nối PostgreSQL miễn phí, lấy từ Neon (neon.tech) hoặc Supabase.
# Dạng: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Lấy MIỄN PHÍ tại https://aistudio.google.com/apikey (đăng nhập Gmail, không cần
# thẻ thanh toán). Không bắt buộc để chạy server — thiếu biến này thì chatbot AI
# và tóm tắt bệnh sử AI tự tắt, các chức năng khác vẫn hoạt động bình thường.
GEMINI_API_KEY=
# Không bắt buộc — model Gemini dùng cho chatbot công khai và tóm tắt bệnh sử.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_SUMMARY_MODEL=gemini-3.6-flash

# Gửi mã OTP xác thực đăng ký/đăng nhập (2FA) qua email. KHÔNG bắt buộc để chạy
# server — thiếu các biến này thì mã OTP được IN RA CONSOLE của server thay vì
# gửi email thật, vẫn đăng ký/đăng nhập thử được bình thường (xem log server).
# Cách lấy MIỄN PHÍ với Gmail: bật xác minh 2 bước cho tài khoản Gmail, sau đó
# tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords rồi dùng
# mật khẩu đó cho SMTP_PASS (không dùng mật khẩu Gmail thật).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Không bắt buộc — mặc định dùng luôn SMTP_USER làm địa chỉ người gửi.
SMTP_FROM=
