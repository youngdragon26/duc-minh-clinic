PORT=4000
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-trien-khai-that
ADMIN_REGISTER_CODE=DUCMINH-ADMIN-2026

# Bật bước xác thực OTP (2FA) khi đăng ký/đăng nhập — mặc định TẮT (không đặt biến
# này, hoặc đặt khác "true") thì đăng ký/đăng nhập cấp token ngay, không cần OTP.
# Chỉ nên đặt =true SAU KHI đã cấu hình SMTP_* bên dưới để mã OTP thật sự gửi được
# tới email người dùng — bật lên mà chưa có SMTP thì không ai đăng nhập được (mã
# chỉ nằm trong log server). Toàn bộ code OTP vẫn giữ nguyên dù bật hay tắt.
REQUIRE_OTP=false

# Chuỗi kết nối PostgreSQL miễn phí, lấy từ Neon (neon.tech) hoặc Supabase.
# Dạng: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Lấy MIỄN PHÍ tại https://aistudio.google.com/apikey (đăng nhập Gmail, không cần
# thẻ thanh toán). Không bắt buộc để chạy server — thiếu biến này thì chatbot AI
# và tóm tắt bệnh sử AI tự tắt, các chức năng khác vẫn hoạt động bình thường.
GEMINI_API_KEY=
# Không bắt buộc — model Gemini dùng cho chatbot công khai và tóm tắt bệnh sử.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_SUMMARY_MODEL=gemini-3.6-flash

# Chạy chatbot/trợ lý AI bằng mô hình NGAY TRÊN MÁY qua Ollama (https://ollama.com) thay cho
# Gemini — không bị giới hạn 20 lượt/ngày của gói Gemini miễn phí. Chỉ dùng khi server chạy
# cùng máy với Ollama (bản deploy trên Render để trống / "gemini"). Tìm kiếm tài liệu (RAG)
# vẫn nhúng vector bằng Gemini, nên muốn chatbot trích dẫn Cẩm nang MSD thì vẫn cần GEMINI_API_KEY.
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:1.7b  (card 4 GB VRAM: nằm trọn trên GPU, ~1-4s/câu; card >= 6 GB thì dùng qwen3:4b-instruct)
#   KHÔNG dùng qwen3:4b — bản đó là Thinking-2507, luôn "suy nghĩ" hàng nghìn token, chậm 20-60s.
# OLLAMA_HOST=http://127.0.0.1:11434
# Ngữ cảnh tối đa (token) — prompt chatbot dài vài nghìn token, đừng để thấp hơn 8192.
# OLLAMA_NUM_CTX=8192
# Giữ model trong bộ nhớ bao lâu sau câu hỏi cuối (tránh mất vài giây nạp lại model).
# OLLAMA_KEEP_ALIVE=30m
# Model embedding để chatbot tìm câu trả lời mẫu (tải: ollama pull qwen3-embedding:0.6b, ~0,6 GB VRAM).
# Đổi model thì chạy lại: node scripts/seed-chat-examples.js
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Cho bản deploy trên Render dùng Ollama trên laptop qua đường hầm Cloudflare (npm run tunnel).
# Đặt CÙNG 1 chuỗi bí mật dài ở .env của laptop VÀ ở Environment trên Render. Để trống = tắt tính năng.
# Laptop tắt/tắt script thì sau tối đa 5 phút Render tự quay về Gemini (cần GEMINI_API_KEY).
# OLLAMA_API_KEY=
# Chỉ cần ở laptop — địa chỉ bản deploy để script báo địa chỉ đường hầm lên.
# REMOTE_SERVER_URL=https://duc-minh-clinic.onrender.com
# Bước mở rộng câu hỏi (Multi-Query + HyDE) tốn thêm 1 lượt gọi AI trước mỗi câu trả lời —
# mặc định bật với Gemini, TẮT với Ollama cho nhanh. Đặt true/false để ép bật/tắt.
# AI_QUERY_EXPANSION=false
# Prompt rút gọn cho model nhỏ (mặc định bật với Ollama, tắt với Gemini). Đo bằng: npm run eval-chat
# AI_COMPACT_PROMPT=true

# Gửi mã OTP xác thực đăng ký/đăng nhập (2FA) qua email. KHÔNG bắt buộc để chạy
# server — thiếu các biến này thì mã OTP được IN RA CONSOLE của server thay vì
# gửi email thật, vẫn đăng ký/đăng nhập thử được bình thường (xem log server).
# Cách lấy MIỄN PHÍ với Gmail: bật xác minh 2 bước cho tài khoản Gmail, sau đó
# tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords rồi dùng
# mật khẩu đó cho SMTP_PASS (không dùng mật khẩu Gmail thật).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Không bắt buộc — mặc định dùng luôn SMTP_USER làm địa chỉ người gửi.
SMTP_FROM=
# In ra thời gian từng bước của chatbot (tìm tài liệu, đọc prompt, sinh câu trả lời) để dò chỗ chậm.
# AI_DEBUG=true
